# Google Gemini API key. Get one from Google AI Studio.
GEMINI_API_KEY=your_api_key_here

# Current Gemini model used by the app. Change this if your account exposes another model.
GEMINI_MODEL=gemini-2.5-flash

# Set true to run without an API key. The backend returns a clearly marked demo document.
DEMO_MODE=false

# Frontend -> backend URL
BACKEND_URL=http://127.0.0.1:8000

# Optional branding
APP_NAME=LegalEase
COMPANY_NAME=LegalEase
